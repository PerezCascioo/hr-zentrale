rules_version = '2';
// Firestore-Regeln für HR Zentral (Projekt hr-dashboardll).
// Diese Datei ist nur eine Kopie zum Nachschlagen. Wirksam sind die Regeln erst,
// wenn sie in der Firebase-Konsole unter Firestore Database → Regeln eingefügt und veröffentlicht werden.
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerDoc() { return /databases/$(database)/documents/meta/owner; }
    // Leitung: der Haupt-Zugang (meta/owner, nur solange das gemeinsame Leitungs-Passwort nicht abgeschaltet ist)
    // oder ein Leitungs-Mitglied mit eigenem Passwort (leitung/<uid>)
    function isLeitung() {
      return request.auth != null && (
        (exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid
          && !get(/databases/$(database)/documents/hr/content).data.get('leitungPwAus', false))
        || exists(/databases/$(database)/documents/leitung/$(request.auth.uid)));
    }
    function wStart(wid) { return timestamp.date(int(wid.split('-')[1]), int(wid.split('-')[2]), int(wid.split('-')[3])); }
    function nachweis(id) { return /databases/$(database)/documents/nachweise/$(id); }
    function nowMs() { return request.time.toMillis(); }
    // Ist der angemeldete Benutzer dieser Mitarbeiter? (eigenes Passwort, verknüpft in zugang/<konto>)
    function zugangDoc(kid) { return /databases/$(database)/documents/zugang/$(kid); }
    function me(kid) {
      return isLeitung() || (request.auth != null && kid is string && exists(zugangDoc(kid))
        && get(zugangDoc(kid)).data.uid == request.auth.uid
        // Mit dem Startpasswort der Leitung geht noch nichts, erst nach dem Ändern
        && get(zugangDoc(kid)).data.get('start', false) != true);
    }

    // Mitarbeiter-Passwörter: Die Leitung vergibt Startpasswörter (legt das Konto an).
    // Der Mitarbeiter darf nur vermerken, dass er sein Startpasswort geändert hat.
    match /zugang/{kid} {
      allow read: if true;
      allow create, delete: if isLeitung();
      allow update: if isLeitung() || (request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','v','seit','start'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.v == resource.data.v
        && request.resource.data.start == false);
    }

    // Leitungs-Mitglieder mit eigenem Passwort
    match /leitung/{luid} {
      allow read: if request.auth != null && (request.auth.uid == luid || isLeitung());
      allow write: if isLeitung();
    }

    match /meta/owner {
      allow read: if true;
      allow create: if request.auth != null && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /config/{d} {
      allow read, write: if isLeitung();
    }

    // Protokoll: lesen nur Leitung. Einträge anlegen darf jeder (z. B. „Secret gefunden“, „Nachweis eingereicht“),
    // aber nur kurze Texte und nie ändern oder löschen.
    match /log/{id} {
      allow read, update, delete: if isLeitung();
      allow create: if isLeitung() || (request.auth != null
        && request.resource.data.keys().hasOnly(['zeit','text','by'])
        && request.resource.data.text is string && request.resource.data.text.size() < 300
        && request.resource.data.zeit is number
        && request.resource.data.zeit > nowMs() - 600000 && request.resource.data.zeit < nowMs() + 600000);
    }

    match /data/users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // LI-Nachweise: nur für eingetragene Mitarbeiter, Screenshot höchstens 2 Stunden alt,
    // Dokument-ID muss zum Mitarbeiter passen (li-<konto>-<JJJJMMTTHH>).
    match /nachweise/{id} {
      allow read: if true;
      allow create: if isLeitung() || (
        me(request.resource.data.kontoId)
        && exists(/databases/$(database)/documents/konten/$(request.resource.data.kontoId))
        && request.resource.data.keys().hasOnly(['kontoId','name','bild','eingereicht','zeit','datum','uhrzeit','ki','slot','by'])
        && id.matches('li-' + request.resource.data.kontoId + '-[0-9]{10}(-[0-9]+)?')
        && request.resource.data.bild is string && request.resource.data.bild.size() < 200
        && request.resource.data.name is string && request.resource.data.name.size() < 80
        && request.resource.data.zeit is number
        && request.resource.data.zeit > nowMs() - 7500000
        && request.resource.data.zeit < nowMs() + 600000
        && (!('ki' in request.resource.data) || request.resource.data.ki is map)
        && (!('slot' in request.resource.data) || (request.resource.data.slot is string && request.resource.data.slot.size() < 80)));
      allow update, delete: if isLeitung();
    }

    // Automatisch annehmen nur für den ersten Nachweis pro Stunde (ID ohne Zusatz) und nur frische Screenshots.
    match /pruefung/{id} {
      allow read: if true;
      allow create: if isLeitung() || (
        request.resource.data.keys().hasOnly(['status','grund','by','zeit'])
        && request.resource.data.status == 'angenommen'
        && request.resource.data.by == 'auto'
        && id.matches('li-[A-Za-z0-9_]+-[0-9]{10}')
        && exists(nachweis(id))
        && me(get(nachweis(id)).data.kontoId)
        && get(nachweis(id)).data.get('ki', {}).get('ok', false) == true
        && get(nachweis(id)).data.zeit > nowMs() - 7500000);
      allow update, delete: if isLeitung();
    }

    match /feedback/{id} {
      allow read: if isLeitung();
      allow create: if request.resource.data.keys().hasOnly(['name','kontoId','art','text','zeit'])
        && request.resource.data.art in ['vorschlag','feedback','problem']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string && request.resource.data.name.size() < 80
        && request.resource.data.kontoId is string && request.resource.data.kontoId.size() < 80
        && (request.resource.data.kontoId == '' || me(request.resource.data.kontoId))
        && request.resource.data.zeit is number;
      allow update, delete: if isLeitung();
    }

    // Geschenk der Woche (w-JJJJ-MM-TT): nur einmal anlegen, nur in der eigenen Woche.
    // Secret der Woche (secret-w-JJJJ-MM-TT): zusätzlich muss der angeklickte Ort mit dem geheimen Ort
    // in config/secret übereinstimmen (das kann nur die Leitung lesen), gerade sichtbar sein und zum letzten Versuch der Person passen.
    function secretCfg() { return get(/databases/$(database)/documents/config/secret).data; }
    function versuch(kid) { return get(/databases/$(database)/documents/versuche/$(kid)).data; }
    match /geschenke/{wid} {
      allow read: if true;
      allow create: if request.resource.data.zeit == request.time
        && request.resource.data.name is string && request.resource.data.name.size() < 80
        && request.resource.data.kontoId is string
        && me(request.resource.data.kontoId)
        && exists(/databases/$(database)/documents/konten/$(request.resource.data.kontoId))
        && request.time >= wStart(wid.replace('secret-', '')) - duration.value(2, 'h')
        && request.time < wStart(wid.replace('secret-', '')) + duration.value(7, 'd')
        && (
          (wid.matches('w-[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && request.resource.data.keys().hasOnly(['kontoId','name','zeit']))
          ||
          (wid.matches('secret-w-[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && request.resource.data.keys().hasOnly(['kontoId','name','zeit','ort'])
            && exists(/databases/$(database)/documents/config/secret)
            && secretCfg().wid == wid.replace('secret-', '')
            && request.resource.data.ort == secretCfg().ort
            // Der echte Stern ist pro Stunde nur 12 Minuten sichtbar (+2 Minuten Kulanz)
            && (request.time.minutes() + secretCfg().off) % 60 < 14
            && exists(/databases/$(database)/documents/versuche/$(request.resource.data.kontoId))
            && versuch(request.resource.data.kontoId).ort == request.resource.data.ort
            && versuch(request.resource.data.kontoId).wid == secretCfg().wid
            && versuch(request.resource.data.kontoId).t > request.time - duration.value(2, 'm'))
        );
      allow update, delete: if isLeitung();
    }

    // Secret-Versuche: pro Mitarbeiter höchstens ein Versuch alle 30 Minuten.
    match /versuche/{kid} {
      allow read: if true;
      allow create: if me(kid) && exists(/databases/$(database)/documents/konten/$(kid))
        && request.resource.data.keys().hasOnly(['ort','wid','t'])
        && request.resource.data.t == request.time
        && request.resource.data.ort is string && request.resource.data.ort.size() < 30
        && request.resource.data.wid is string && request.resource.data.wid.size() < 30;
      allow update: if me(kid) && exists(/databases/$(database)/documents/konten/$(kid))
        && request.resource.data.keys().hasOnly(['ort','wid','t'])
        && request.resource.data.t == request.time
        && request.resource.data.ort is string && request.resource.data.ort.size() < 30
        && request.resource.data.wid is string && request.resource.data.wid.size() < 30
        && request.time > resource.data.t + duration.value(30, 'm');
      allow delete: if isLeitung();
    }

    // Bilder: anlegen darf jeder. Profilbilder (pp-<konto>) darf jeder auch ersetzen oder entfernen.
    match /bilder/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['src','zeit'])
        && request.resource.data.src is string && request.resource.data.src.size() < 1000000;
      allow update: if isLeitung() || (id.matches('pp-.+') && me(id.replace('^pp-', ''))
        && request.resource.data.keys().hasOnly(['src','zeit'])
        && request.resource.data.src is string && request.resource.data.src.size() < 1000000);
      allow delete: if isLeitung() || (id.matches('pp-.+') && me(id.replace('^pp-', '')));
    }

    match /{coll}/{id} {
      allow read: if !(coll in ['config','log','feedback']);
      allow write: if isLeitung() && !(coll in ['meta','config','log','nachweise','bilder','pruefung','feedback','geschenke','versuche','zugang','leitung']);
    }
  }
}
